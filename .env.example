# OpenAI 호환 API 설정. 기본은 GMS(OpenAI)다.
LLM_KEY=
LLM_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
LLM_CHAT_MODEL=gpt-4o
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_USE_RESPONSES_API=true
# 비워 두면 temperature를 보내지 않는다(일부 모델은 이 값을 거부한다).
LLM_TEMPERATURE=

# Gemini 예시(Responses API 미지원, 임베딩 모델이 달라 다시 색인 필요)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_CHAT_MODEL=gemini-2.5-flash
# LLM_EMBEDDING_MODEL=gemini-embedding-001
# LLM_USE_RESPONSES_API=false
# LLM_EMBEDDING_BATCH_SIZE=100
